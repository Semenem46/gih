# Скопируй в .env и заполни своими значениями.

# Получить у @BotFather
BOT_TOKEN=123456:ABCDEF...

# Твой Telegram user-id (узнать: @userinfobot). Можно несколько через запятую.
ADMIN_IDS=123456789

# Брендинг
AUTHOR_NAME=Никита
AUTHOR_USERNAME=your_tg_username
SUPPORT_USERNAME=your_tg_username

# Ссылки для кнопок follow-up.
# Если ссылки нет (например, ещё нет кейсов) — оставь поле пустым,
# кнопка просто не покажется. Лучше пусто, чем «битая» ссылка.
LINK_CASES=
LINK_BOOK_CALL=
LINK_CHANNEL=

# Drip-цепочка: минуты после получения файла (по умолчанию 30м / 1д / 3д / 7д)
DRIP_SCHEDULE_MINUTES=30,1440,4320,10080

# Прочее
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
